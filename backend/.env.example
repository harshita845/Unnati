# Copy to .env for local development. Never commit real values.
# On Vercel set these in Project → Settings → Environment Variables.

# --- Core ---
NODE_ENV=development
PORT=5001
MONGODB_URI=
JWT_SECRET=
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173

# --- Cloudinary (images, and Scan Bill uploads) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Payments / SMS / notifications (as used today) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_MODE=
PHONEPE_MERCHANT_ID=
PHONEPE_SALT_KEY=
PHONEPE_SALT_INDEX=
PHONEPE_ENV=
SMS_INDIA_HUB_API_KEY=
SMS_INDIA_HUB_SENDER_ID=
SMS_INDIA_HUB_DLT_TEMPLATE_ID=
FIREBASE_SERVICE_ACCOUNT=

# --- Scan Bill (Admin POS → AI bill reading) ---
# anthropic | gemini | fake (offline sample bill, local only: refused when NODE_ENV=production) | off
# Unset: uses whichever of the two keys below is present.
OCR_PROVIDER=fake
# Optional model override. Defaults: claude-opus-5-5 (anthropic), gemini-3.8-flash (gemini).
# Cheaper/faster options: claude-sonnet-5-5, claude-haiku-5-5.
OCR_MODEL=
# Only the key for the provider you use. Server-side only: never put these in the frontend.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Claude effort for extraction: low (default, fastest) | medium | high
OCR_EFFORT=low
# Claude: server-side refusal fallback (beta). Gemini: when the model stays busy (503 / rate limit)
# after retries, try OCR_FALLBACK_MODEL once. Set to "off" to disable both.
OCR_FALLBACKS=on
# Gemini model tried when the main one is busy (default gemini-3.5-flash)
OCR_FALLBACK_MODEL=
# Gemini model tried once when both of the above are busy or out of today's quota (default gemini-3.5-flash-lite)
OCR_LAST_RESORT_MODEL=
OCR_MAX_FILE_MB=10
# Scans per admin per minute
OCR_RATE_LIMIT=20
# AI calls per calendar month (scans + re-scans + repair retries)
OCR_MONTHLY_LIMIT=500
# Time budget for one scan (ms). Vercel Hobby functions can run up to 300 s.
OCR_TIMEOUT_MS=45000
